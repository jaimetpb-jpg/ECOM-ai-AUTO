# ============================================================
#  AI Ecommerce System v5.1 — Variables de Entorno Requeridas
#  Copia este archivo como .env y rellena cada valor.
#  NUNCA subas el .env real al repositorio.
# ============================================================

# ── API PRINCIPAL ────────────────────────────────────────────
# Clave de autenticación para los endpoints del sistema
API_KEY=your_secret_api_key_here

# Secreto para verificar webhooks entrantes (Slack, etc.)
WEBHOOK_SECRET=your_webhook_secret_here

# ── LLM PROVIDERS ────────────────────────────────────────────
# Claude (Anthropic) — Modelos: claude-sonnet-4-6, claude-haiku-4-5-20251001
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — Modelo: gpt-4o-mini
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Groq — Modelo: llama-3.3-70b (tier gratuito)
# Obtener en: https://console.groq.com/
GROQ_API_KEY=gsk_...

# ── BASE DE DATOS ─────────────────────────────────────────────
# Supabase (PostgreSQL + pgvector)
# Obtener en: https://supabase.com/ → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...

# Redis — Para rate limiting y caché (opcional, fallback a memoria)
# Formato: redis://[:password@]host[:port][/db]
REDIS_URL=redis://localhost:6379

# ── PLATAFORMAS DE ADS ────────────────────────────────────────
# Meta (Facebook/Instagram Ads)
# Obtener en: https://developers.facebook.com/ → My Apps
META_ACCESS_TOKEN=EAAxxxxx
META_AD_ACCOUNT_ID=act_123456789

# TikTok Ads
# Obtener en: https://ads.tiktok.com/marketing_api/homepage
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_ADVERTISER_ID=123456789

# Google Ads
# Obtener en: https://developers.google.com/google-ads/api/docs/first-call/overview
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# ── GENERACIÓN DE CONTENIDO ───────────────────────────────────
# Replicate — Para imágenes con Flux.1 Dev
# Obtener en: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# HeyGen — Para videos con avatar IA
# Obtener en: https://app.heygen.com/settings (API section)
HEYGEN_API_KEY=your_heygen_api_key

# ── SCRAPING / INVESTIGACIÓN ──────────────────────────────────
# Apify — Para scraping Amazon, reviews, etc.
# Obtener en: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_...

# Helium 10 — Para análisis de keywords Amazon
# Obtener en: https://www.helium10.com/account/api-settings
HELIUM10_API_KEY=your_helium10_key

# ── COMUNICACIONES ────────────────────────────────────────────
# Twilio — Para WhatsApp cart recovery
# Obtener en: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Slack — Para notificaciones y human gates
# Obtener en: https://api.slack.com/apps → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=your_slack_signing_secret

# ── OBSERVABILIDAD ────────────────────────────────────────────
# Habilitar métricas Prometheus (true/false)
PROMETHEUS_ENABLED=true
# Puerto para scraping de métricas
PROMETHEUS_PORT=9091

# ── PARÁMETROS DEL SISTEMA ────────────────────────────────────
# Rate limiting: máximo de requests por minuto al LLM
RATE_LIMIT_RPM=60

# Número de clusters para el Niche Clusterer (default: 8)
NICHE_CLUSTERER_K=8

# Ruta para persistir el estado del clusterer
NICHE_CLUSTERER_STATE_PATH=./niche_clusterer_state.pkl

# Coeficientes del modelo de saturación (JSON)
# Formato: {"alpha": 0.5, "beta": 0.3, "gamma": 0.2}
SATURATION_COEFS={"alpha":0.5,"beta":0.3,"gamma":0.2}

# ── n8n WORKFLOW VARS ─────────────────────────────────────────
# URL base de la API (usado por los workflows n8n para llamar al sistema)
API_BASE_URL=http://localhost:8000

# ID del tenant por defecto para workflows automáticos
TENANT_ID=default

# Nichos separados por coma (usado en n8n orchestrator workflow)
NICHES=masajeadores cervicales,vitaminas cabello,accesorios fitness

# ── MEDUSA STORE (ecommerce backend) ─────────────────────────
# URL de la base de datos Postgres para Medusa
DATABASE_URL=postgres://postgres:postgres_change_me@localhost:5432/ecommerce_ai

# URL del backend de Medusa (para configurar frontend/admin)
MEDUSA_BACKEND_URL=http://localhost:9000

# Modo de trabajo de Medusa (server | worker | shared)
MEDUSA_WORKER_MODE=shared

# Secretos de cookies y JWT (mínimo 32 caracteres — usar: openssl rand -hex 32)
COOKIE_SECRET=change_this_cookie_secret_min_32_chars
JWT_SECRET=change_this_jwt_secret_min_32_chars

# CORS — URLs permitidas (separadas por coma)
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7001,http://localhost:8000

# ── STRIPE (pagos en tienda) ──────────────────────────────────
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── SENDGRID (emails transaccionales) ────────────────────────
# Obtener en: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@tutienda.com
# IDs de templates en SendGrid (crear en: https://mc.sendgrid.com/dynamic-templates)
SENDGRID_ORDER_TEMPLATE=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_RESET_TEMPLATE=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_SHIPPED_TEMPLATE=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CART ABANDONED SUBSCRIBER ────────────────────────────────
# URL pública de tu tienda (para links en mensajes de recuperación)
STORE_URL=https://tutienda.com

# URL interna de la API del sistema AI (para el subscriber JS)
AI_API_URL=http://localhost:8000

# Nicho de la tienda (para personalizar mensajes WhatsApp)
STORE_NICHE=masajeadores cervicales

# ── CORS Y SEGURIDAD API ──────────────────────────────────────
# Orígenes permitidos para CORS (separados por coma)
# En producción: reemplazar localhost con tu dominio real
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5678

# ── SCRAPING ADICIONAL ────────────────────────────────────────
# Helium 10 — Para análisis de keywords Amazon
# Obtener en: https://www.helium10.com/account/api-settings

# ── MEDUSA STORE — ALMACENAMIENTO S3 ─────────────────────────
# Node environment (development | production)
NODE_ENV=development

# DigitalOcean Spaces / AWS S3 para imágenes de productos
# Obtener en: https://cloud.digitalocean.com/spaces o AWS Console
S3_REGION=nyc3
S3_BUCKET=ecommerce-ai-assets
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here
S3_PUBLIC_URL=https://ecommerce-ai-assets.nyc3.digitaloceanspaces.com
