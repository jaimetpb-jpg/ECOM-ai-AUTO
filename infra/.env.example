# ═══════════════════════════════════════════════════════════════════════════════
# AI Ecommerce System V5.1 — Environment Variables
# Copy to: cp infra/.env.example .env
# NEVER commit .env to git
# ═══════════════════════════════════════════════════════════════════════════════

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...        # Claude Sonnet 4.6 + Haiku 4.5  [REQUIRED]
OPENAI_API_KEY=sk-...               # GPT-4o Mini (creative hooks)    [REQUIRED]
GROQ_API_KEY=gsk_...                # Llama 3.3 70B free tier (bulk)  [REQUIRED]
REPLICATE_API_TOKEN=r8_...          # Flux.1 Dev (image generation)   [optional]

# ─── DATABASE ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co  # [REQUIRED]
SUPABASE_KEY=eyJ...                    # anon key (service key for migrations) [REQUIRED]
REDIS_URL=redis://localhost:6379       # Rate limiting — required for multi-worker [REQUIRED]

# ─── TIKTOK ADS ───────────────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=...             # TikTok Business API token        [REQUIRED]
TIKTOK_ADVERTISER_ID=70...          # TikTok Ad Account ID             [REQUIRED]

# ─── META ADS ─────────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=EAA...            # Meta Business token              [REQUIRED]
META_AD_ACCOUNT_ID=act_...          # Ad account ID                    [REQUIRED]

# ─── GOOGLE ADS ───────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=...      # [optional — for Google scaling tier]
GOOGLE_ADS_CUSTOMER_ID=...
GOOGLE_ADS_CLIENT_ID=...
GOOGLE_ADS_CLIENT_SECRET=...
GOOGLE_ADS_REFRESH_TOKEN=...

# ─── PRODUCT RESEARCH ─────────────────────────────────────────────────────────
HELIUM10_API_KEY=...                # Amazon research — Starter $39/mo [optional]
APIFY_TOKEN=apify_api_...           # Amazon/ML scraping               [optional]

# ─── MESSAGING ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...            # WhatsApp cart recovery           [optional]
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── SLACK (Human Gates — V5.1 kill-switch alerts) ────────────────────────────
SLACK_BOT_TOKEN=xoxb-...            # [REQUIRED for kill-switch alerts]
SLACK_SIGNING_SECRET=...            # HMAC verification for webhook auth [REQUIRED]
                                    # Get from: Slack App > Basic Information

# ─── INFRASTRUCTURE ───────────────────────────────────────────────────────────
API_KEY=change-this-to-a-secure-random-string  # Internal API auth     [REQUIRED]
WEBHOOK_SECRET=change-this-random-32-chars     # HMAC for cart webhook [REQUIRED]
N8N_WEBHOOK_URL=http://localhost:5678          # n8n base URL
N8N_API_KEY=...                                # n8n API key
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5678

# ─── HEYGEN (Avatar video generation) ─────────────────────────────────────────
HEYGEN_API_KEY=...                  # [optional — video ad generation]

# ─── STORE (MedusaJS) ─────────────────────────────────────────────────────────
MEDUSA_BACKEND_URL=http://localhost:9000  # [optional]
MEDUSA_API_KEY=...

# ─── V4.4: NicheClusterer ─────────────────────────────────────────────────────
NICHE_CLUSTERER_K=5                             # Number of clusters (default: 5)
NICHE_CLUSTERER_STATE_PATH=niche_clusterer.json # Persist fitted centroids

# ─── V5.1: Minimum required to boot ──────────────────────────────────────────
# System will start without optional keys but these are REQUIRED:
#   ANTHROPIC_API_KEY, OPENAI_API_KEY, GROQ_API_KEY
#   SUPABASE_URL, SUPABASE_KEY
#   API_KEY (internal auth)
#   SLACK_BOT_TOKEN (kill-switch alerts)
#   TIKTOK_ACCESS_TOKEN + TIKTOK_ADVERTISER_ID (ad operations)
#   META_ACCESS_TOKEN + META_AD_ACCOUNT_ID (ad operations)

# ─── PROMETHEUS / GRAFANA (V5.1 — Grok) ──────────────────────────────────────
PROMETHEUS_PORT=9091
PROMETHEUS_ENABLED=true
# Grafana: http://localhost:3001 (admin/admin — cambiar en prod)

# ─── BULKHEAD TUNING (V5.1 — Grok) ───────────────────────────────────────────
# Estos son los valores por defecto hardcoded en get_bulkhead()
# Ajustar según tus rate limits de API
# engine_creative: 8  (evita explosión de costos LLM)
# engine_ads:      12 (campañas en paralelo)
# orchestrator:    12 (productos procesados simultáneamente)
# llm_anthropic:   15
# llm_openai:      20
# llm_groq:        30
